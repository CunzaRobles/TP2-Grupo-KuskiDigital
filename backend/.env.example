# Puerto del servidor Express
PORT=3000

# Conexión a PostgreSQL en Supabase (SSL)
# Supabase → Project Settings → Database → Connection string
# Local: Session pooler (puerto 5432). Vercel: Transaction pooler (puerto 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Secreto para firmar los JWT (usar una cadena larga y aleatoria; obligatorio en producción)
JWT_SECRET=cambia-este-secreto
# Duración de la sesión (formato de jsonwebtoken: 7d, 12h...)
JWT_EXPIRES_IN=7d

# URL pública del frontend, permitida por CORS (varias separadas por comas).
# Fuera de producción también se permite siempre http://localhost:5173.
FRONTEND_URL=

# Latencia simulada de la pasarela de pago, en milisegundos (por defecto 1000–2000)
PAGO_LATENCIA_MIN_MS=1000
PAGO_LATENCIA_MAX_MS=2000

# Supabase Storage para las imágenes de productos (bucket público "productos").
# Supabase → Project Settings → API. La service_role key NUNCA se expone al frontend.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_STORAGE_BUCKET=productos
