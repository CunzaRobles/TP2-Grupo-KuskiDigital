# Puerto del servidor Express
PORT=3000

# Conexión a PostgreSQL en Supabase (SSL)
# Supabase → Project Settings → Database → Connection string
# Local: Session pooler (puerto 5432). Vercel: Transaction pooler (puerto 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Secreto para firmar los JWT (usar una cadena larga y aleatoria; obligatorio en producción)
JWT_SECRET=cambia-este-secreto
# Duración de la sesión (formato de jsonwebtoken: 7d, 12h...)
JWT_EXPIRES_IN=7d

# URL pública del frontend, permitida por CORS (varias separadas por comas).
# Fuera de producción también se permite siempre http://localhost:5173.
FRONTEND_URL=

# Latencia simulada de la pasarela de pago, en milisegundos (por defecto 1000–2000)
PAGO_LATENCIA_MIN_MS=1000
PAGO_LATENCIA_MAX_MS=2000

# Supabase Storage para las imágenes de productos (bucket público "productos").
# Supabase → Project Settings → API. La service_role key NUNCA se expone al frontend.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_STORAGE_BUCKET=productos

# Datos del proveedor en la constancia del Libro de Reclamaciones (D.S. 011-2011-PCM).
# Opcionales: si faltan, la constancia no los muestra. Deben coincidir con
# frontend/src/features/legal/empresa.js.
EMPRESA_RUC=
EMPRESA_DOMICILIO=

# Asistente virtual (chatbot): contacto del asesor humano.
# WhatsApp en formato internacional (p. ej. +51 984 000 000); si falta, solo se ofrece el correo.
CHATBOT_WHATSAPP=
CHATBOT_CORREO=contacto@kuski.pe

# Contraseña de los usuarios de prueba que crean los seeders (npm run db:seed / db:reset).
# Mínimo 8 caracteres. Obligatoria fuera de NODE_ENV=development; en desarrollo, si falta, se
# usa una por defecto que solo sirve para una base local. Defínela SIEMPRE al sembrar la base
# compartida de Supabase. Las credenciales se entregan por canal privado: no las subas al repo.
SEED_PASSWORD=
