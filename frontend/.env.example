# Variables opcionales del frontend (Vite solo expone las que empiezan con VITE_).
# Copia este archivo a frontend/.env.local si necesitas cambiarlas.

# Base de la API. Por defecto /api/v1 (en desarrollo Vite la redirige al backend).
# VITE_API_URL=/api/v1

# Tiles del mapa de comunidades (home). Por defecto Stadia "Alidade Smooth": en localhost no pide
# clave; en producción registra el dominio gratis en stadiamaps.com o usa otra URL con clave,
# por ejemplo CARTO Positron (hoy exige API key).
# VITE_MAP_TILES_URL=https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}{r}.png
# VITE_MAP_TILES_ATTRIBUTION=&copy; Stadia Maps &copy; OpenMapTiles &copy; OpenStreetMap
