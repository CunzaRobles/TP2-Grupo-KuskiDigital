        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="P1 · 1. Iniciar sesión (POST /auth/login)" enabled="true">
          <stringProp name="TestPlan.comments">Login con un usuario del CSV; el backend responde 200 y guarda la sesión en la cookie httpOnly kuski_token.</stringProp>
