{
  "name": "kuski-digital",
  "private": true,
  "version": "0.0.0",
  "description": "Tienda e-commerce de Kuski Agroindustria S.A. (monorepo frontend + backend)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n frontend,backend -c magenta,cyan \"npm run dev -w frontend\" \"npm run dev -w backend\"",
    "build": "npm run build -w frontend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "e2e": "npm run e2e -w frontend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:migrate:undo": "npm run db:migrate:undo -w backend",
    "db:seed": "npm run db:seed -w backend",
    "db:reset": "npm run db:reset -w backend",
    "db:test": "npm run db:test -w backend",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.9.9"
  }
}
