# Puerto del servidor Express
PORT=3000

# Conexión a PostgreSQL en Supabase (Session pooler, puerto 5432, SSL)
# Supabase → Project Settings → Database → Connection string → Session pooler
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Secreto para firmar los JWT (usar una cadena larga y aleatoria; obligatorio en producción)
JWT_SECRET=cambia-este-secreto
# Duración de la sesión (formato de jsonwebtoken: 7d, 12h...)
JWT_EXPIRES_IN=7d

# Orígenes permitidos por CORS (separados por comas). Por defecto, el frontend de Vite.
CORS_ORIGIN=http://localhost:5173

# Latencia simulada de la pasarela de pago, en milisegundos (por defecto 1000–2000)
PAGO_LATENCIA_MIN_MS=1000
PAGO_LATENCIA_MAX_MS=2000

# Supabase Storage para las imágenes de productos (bucket público "productos").
# Supabase → Project Settings → API. La service_role key NUNCA se expone al frontend.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_STORAGE_BUCKET=productos
